{
	"name": "whispr",
	"version": "1.2.0",
	"description": "Share encrypted messages securely with configurable expiration and view limits. Create temporary, password-protected messages with customizable security settings.",
	"type": "module",
	"private": true,
	"author": "@itsEzz",
	"license": "MIT",
	"homepage": "https://github.com/itsEzz/whispr#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsEzz/whispr.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/whispr/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"encryption",
		"secure-messaging",
		"privacy",
		"temporary-messages",
		"password-protection",
		"self-destructing-messages",
		"security",
		"web-app",
		"typescript",
		"tailwindcss",
		"drizzle-orm"
	],
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt .",
		"lint": "vp fmt --check . && vp lint .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:drop": "drizzle-kit drop",
		"sc:update": "pnpm dlx shadcn-svelte@latest update"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@itsezz/try-catch": "^1.5.0",
		"@lucide/svelte": "^1.62.0",
		"@noble/hashes": "^2.4.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/pako": "^3.0.0",
		"@types/qrcode": "^1.5.6",
		"@zxcvbn-ts/core": "3.0.4",
		"@zxcvbn-ts/language-common": "3.0.4",
		"@zxcvbn-ts/language-en": "3.0.2",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "2.1.0",
		"globals": "^17.13.0",
		"human-id": "^4.2.2",
		"js-base64": "^3.9.5",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.2",
		"pako": "^3.0.3",
		"qrcode": "^1.5.4",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-seo": "^2.0.0",
		"svelte-sonner": "^1.2.2",
		"sveltekit-rate-limiter": "^0.8.0",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"xregexp": "^5.1.3",
		"zod": "4.6.7"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"mysql2": "^3.24.6",
		"pino": "10.3.1",
		"pino-pretty": "^13.2.0",
		"pino-roll": "^4.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
